# ─── Architecture — x86_64 BIOS (i386-pc GRUB), 64-bit kernel ───
BR2_x86_64=y
BR2_x86_corei7=y

# ─── Toolchain (musl, match ARM and orchestrator target) ────────
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

# ─── System ─────────────────────────────────────────────────────
BR2_TARGET_GENERIC_HOSTNAME="wraithos"
BR2_TARGET_GENERIC_ISSUE=""
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"

# ─── Init — BusyBox (sama dengan ARM, tanpa systemd) ────────────
BR2_INIT_BUSYBOX=y

# ─── Rootfs overlay ─────────────────────────────────────────────
BR2_ROOTFS_OVERLAY="/home/opc/wraithos-br2-ext/board/wraithos/rootfs_overlay"

# ─── Kernel 6.6 + fragment ──────────────────────────────────────
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="/home/opc/wraithos-br2-ext/board/wraithos/kernel.fragment"
BR2_LINUX_KERNEL_IMAGE=y

# ─── Rootfs squashfs (dual-slot A/B, dari genimage.cfg) ─────────
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_PAD=y

# ─── M28: RAUC + GRUB + libubootenv (PERTAHANKAN dari x86 lama) ─
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_NETWORK=y
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_TARGET_GRUB2_BUILTIN_CONFIG=""
BR2_TARGET_GRUB2_BOOT_PARTITION="hd0,msdos1"
BR2_PACKAGE_LIBUBOOTENV=y
BR2_PACKAGE_LIBUBOOTENV_INSTALL_TOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_GENEXT2FS=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="/home/opc/wraithos-br2-ext/board/wraithos/post-image.sh"

# ─── Runtime packages (match ARM) ───────────────────────────────
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_DROPBEAR_SMALL=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_LIBGCRYPT=y
BR2_PACKAGE_LIBUUID=y
BR2_PACKAGE_POPT=y
BR2_PACKAGE_JSON_C=y

# ─── TPM 2.0 (Item 1: LUKS sealing) ───
BR2_PACKAGE_TPM2_TSS=y
BR2_PACKAGE_TPM2_TOOLS=y

# ─── UEFI Secure Boot (Item 2) ───
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 part_msdos part_gpt normal efi_gop efi_uga all_video search test loadenv configfile serial terminal echo"
