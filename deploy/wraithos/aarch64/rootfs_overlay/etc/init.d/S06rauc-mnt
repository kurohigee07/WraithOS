#!/bin/sh
# RAUC needs writable /mnt to mount bundle, and /run/rauc for status.
# Rootfs is squashfs read-only. Order: create /run dirs, mount tmpfs /mnt,
# then create /mnt/rauc on tmpfs.
case "$1" in
    start)
        echo -n "Setting up RAUC runtime: "
        mkdir -p /run/rauc /run/wraith 2>/dev/null
        grep -q ' /mnt ' /proc/mounts || \
            mount -t tmpfs -o mode=0755,size=32M tmpfs /mnt 2>/dev/null
        mkdir -p /mnt/rauc 2>/dev/null
        grep -q ' /run/rauc ' /proc/mounts || \
            mount -t tmpfs -o mode=0755,size=8M tmpfs /run/rauc 2>/dev/null
        if grep -q ' /mnt ' /proc/mounts && [ -d /mnt/rauc ]; then
            echo "OK"
        else
            echo "FAIL"
            exit 1
        fi
        ;;
esac
