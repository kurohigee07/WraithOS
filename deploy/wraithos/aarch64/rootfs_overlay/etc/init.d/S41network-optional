#!/bin/sh
# Non-blocking DHCP for physical (en*) and virtio (eth*) interfaces.
case "$1" in
    start)
        for d in /sys/class/net/en* /sys/class/net/eth*; do
            [ -d "$d" ] || continue
            iface=$(basename "$d")
            echo -n "Starting network ($iface, best effort): "
            ip link set "$iface" up 2>/dev/null
            udhcpc -i "$iface" -t 1 -T 3 -n -q -b 2>/dev/null
            echo "OK"
        done
        ;;
esac
