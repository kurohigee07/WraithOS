# WraithOS shell lockdown for login shells.
# Do not mark readonly here; .bashrc finalizes the lockdown once.
BASH_ENV=
ENV=
PATH=/usr/sbin:/usr/bin:/sbin:/bin
HISTFILE=/dev/null
HISTSIZE=0
HISTFILESIZE=0
INPUTRC=/etc/inputrc
TMOUT=600
COLORTERM=truecolor
export PATH BASH_ENV ENV HISTFILE HISTSIZE HISTFILESIZE INPUTRC TMOUT COLORTERM
unset PROMPT_COMMAND
umask 0077
ulimit -c 0

# Source drop-in scripts (default-password warning, future additions)
if [ -d /etc/profile.d ]; then
    for _p in /etc/profile.d/*.sh; do
        [ -r "$_p" ] && . "$_p"
    done
    unset _p
fi
