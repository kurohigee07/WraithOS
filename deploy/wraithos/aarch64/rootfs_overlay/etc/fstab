# WraithOS ARM fstab (hardened: noexec on writable dirs)
proc    /proc    proc    defaults    0 0
sysfs   /sys     sysfs   defaults    0 0
devpts  /dev/pts devpts  defaults    0 0
tmpfs   /dev/shm tmpfs   defaults,size=16M,mode=1777,nosuid,nodev,noexec 0 0
tmpfs   /run     tmpfs   defaults,size=32M,mode=0755,nosuid,nodev,noexec 0 0
tmpfs   /tmp     tmpfs   defaults,size=64M,mode=1777,nosuid,nodev,noexec 0 0
tmpfs   /var/log tmpfs   defaults,size=8M,mode=0755,nosuid,nodev,noexec  0 0
tmpfs   /var/tmp tmpfs   defaults,size=8M,mode=1777,nosuid,nodev,noexec  0 0
tmpfs   /var/lib tmpfs   defaults,size=16M,mode=0755,nosuid,nodev,noexec 0 0
