[Unit]
Description=Wraith Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/sbin/wraith-init --config /etc/wraith/orchestrator.toml
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
WorkingDirectory=/
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
