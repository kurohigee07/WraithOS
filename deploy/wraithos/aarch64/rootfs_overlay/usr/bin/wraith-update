#!/bin/sh
set -e

NEW_IMAGE="$1"
if [ ! -f "$NEW_IMAGE" ]; then
    echo "Usage: wraith-update /path/to/rootfs.squashfs"
    exit 1
fi

ACTIVE=$(sed -n 's/.*slot=\([AB]\).*/\1/p' /proc/cmdline | head -1)
if [ -z "$ACTIVE" ]; then
    echo "Cannot detect active slot"
    exit 1
fi

if [ "$ACTIVE" = A ]; then
    TARGET_DEV=/dev/vda3
    NEXT=B
else
    TARGET_DEV=/dev/vda2
    NEXT=A
fi

SIZE=$(wc -c < "$NEW_IMAGE")
LIMIT=$((60 * 1024 * 1024))
if [ "$SIZE" -gt "$LIMIT" ]; then
    echo "ERROR: image too large: $SIZE > $LIMIT"
    exit 1
fi

echo "=== WraithOS Update ==="
echo "Current: $ACTIVE"
echo "Target:  $NEXT ($TARGET_DEV)"
echo "Image:   $NEW_IMAGE ($SIZE bytes)"
echo ""

echo "[1/4] Writing squashfs to $TARGET_DEV..."
dd if="$NEW_IMAGE" of="$TARGET_DEV" bs=1M conv=fsync 2>&1 | tail -1
sync

echo "[2/4] Recomputing dm-verity tree for slot $NEXT..."
/usr/bin/wraith-verity-rehash "$TARGET_DEV" "$NEXT" || {
    echo "ERROR: rehash failed; slot not armed" >&2
    exit 1
}

echo "[3/4] Arming trial boot..."
mkdir -p /boot
grep -q ' /boot ' /proc/mounts || mount -t vfat -o rw /dev/vda1 /boot
rm -f /boot/boot_a /boot/boot_b
/usr/bin/wraith-bootenv trial "$NEXT"

# Arm health gate for next boot
mkdir -p /data/orchestrator 2>/dev/null
printf 'armed %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > /data/orchestrator/rauc.pending 2>/dev/null
sync

echo "[4/4] Done"
echo ""
echo "Update staged for slot $NEXT (3 boot attempts)"
echo "Reboot to activate: reboot"
