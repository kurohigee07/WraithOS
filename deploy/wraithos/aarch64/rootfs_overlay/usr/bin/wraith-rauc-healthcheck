#!/bin/sh
# Background health poller for RAUC trial boots.
# Spawned by S99wraith-init after the orchestrator starts. Only runs
# when /data/orchestrator/rauc.pending exists (written by
# wraith-install-bundle). Polls /readyz for up to 60 s.
#
#   /readyz returns 200 when the HTTP listener is up and SQLite is
#   reachable. /healthz is a shallower check and is not used here.
#
# On success: rauc status mark-good, wraith-bootenv commit, remove
# marker. On timeout: rauc status mark-bad, wraith-bootenv demote,
# remove marker, reboot. The GRUB trial counter falls through to the
# last-known-good slot.
set -u

BOOTED=$(sed -n 's/.*slot=\([AB]\).*/\1/p' /proc/cmdline 2>/dev/null | head -1)
[ -n "$BOOTED" ] || { logger -t rauc-health "cannot detect booted slot"; exit 1; }

# Singleton lock: S99wraith-init can be re-run by the watchdog (crash,
# restart) while a trial boot is still in progress. Two concurrent
# healthchecks would race on `rauc status mark-good/bad` and corrupt
# slot state. mkdir is atomic on FAT/ext4; cleanup via trap on exit.
LOCK_DIR=/run/wraith/healthcheck.lock
mkdir -p /run/wraith
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    exit 0
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT INT TERM

MARKER=/data/orchestrator/rauc.pending
READY_URL=http://127.0.0.1:9090/readyz
TIMEOUT_SECS=60
INTERVAL_SECS=2
LOG_FILE=/data/orchestrator/healthcheck.log

# Dual log: syslog for live visibility, /data for post-mortem.
# /var/log is tmpfs, so logger output is gone after the next reboot.
# The /data file sits on the LUKS volume and survives.
log() {
    msg=$1
    logger -t rauc-health "$msg"
    if [ -d /data/orchestrator ]; then
        printf '%s rauc-health: %s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$msg" \
            >> "$LOG_FILE" 2>/dev/null
    fi
}

[ -f "$MARKER" ] || exit 0

ATTEMPTS=$((TIMEOUT_SECS / INTERVAL_SECS))
i=1
while [ "$i" -le "$ATTEMPTS" ]; do
    code=$(wget -q -T 5 -O /dev/null --server-response "$READY_URL" 2>&1 \
        | awk '/HTTP\//{c=$2} END{print c}')
    if [ "$code" = "200" ]; then
        log "readyz 200 after $((i * INTERVAL_SECS))s, marking good"
        out=$(rauc status mark-good --override-boot-slot="$BOOTED" 2>&1); rc=$?
        printf '%s\n' "$out" | while read -r line; do log "$line"; done
        [ "$rc" -eq 0 ] || log "WARN: rauc status mark-good failed (rc=$rc)"
        out=$(/usr/bin/wraith-bootenv commit 2>&1); rc=$?
        printf '%s\n' "$out" | while read -r line; do log "$line"; done
        [ "$rc" -eq 0 ] || log "WARN: wraith-bootenv commit failed (rc=$rc)"
        rm -f "$MARKER"
        exit 0
    fi
    sleep "$INTERVAL_SECS"
    i=$((i + 1))
done

log "readyz timeout after ${TIMEOUT_SECS}s, marking bad and rebooting"
out=$(rauc status mark-bad --override-boot-slot="$BOOTED" 2>&1); rc=$?
printf '%s\n' "$out" | while read -r line; do log "$line"; done
[ "$rc" -eq 0 ] || log "WARN: rauc status mark-bad failed (rc=$rc)"
out=$(/usr/bin/wraith-bootenv demote 2>&1); rc=$?
printf '%s\n' "$out" | while read -r line; do log "$line"; done
[ "$rc" -eq 0 ] || log "WARN: wraith-bootenv demote failed (rc=$rc)"
rm -f "$MARKER"
sync
reboot
