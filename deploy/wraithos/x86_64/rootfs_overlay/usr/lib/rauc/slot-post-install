#!/bin/sh
# RAUC slot-post-install handler: recompute dm-verity for rootfs slots.
set -eu

CLASS="${1:-}"
NAME="${2:-}"
[ "$CLASS" = "rootfs" ] || exit 0

BOOTNAME="${RAUC_SLOT_BOOTNAME:-}"
if [ -z "$BOOTNAME" ]; then
    case "$NAME" in
        rootfs.0) BOOTNAME=A ;;
        rootfs.1) BOOTNAME=B ;;
        *) echo "slot-post-install: unknown slot '$NAME'" >&2; exit 1 ;;
    esac
fi

case "$BOOTNAME" in
    A) TARGET=/dev/vda2 ;;
    B) TARGET=/dev/vda3 ;;
    *) echo "slot-post-install: invalid bootname '$BOOTNAME'" >&2; exit 1 ;;
esac

exec /usr/bin/wraith-verity-rehash "$TARGET" "$BOOTNAME"
