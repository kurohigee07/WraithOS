#!/bin/sh
# Wraith Boot Contract: 1024-byte GRUB env block on ESP.
ENV_FILE=/boot/grub/grubenv
# Tmp MUST be on the same filesystem as ENV_FILE so the final step is an
# atomic rename. A tmp under /run (tmpfs) would make mv a cross-fs copy+
# truncate, reintroducing the power-loss corruption window.
ENV_TMP=/boot/grub/.grubenv.tmp
mkdir -p /run/wraith

ensure_mount() {
    grep -q ' /boot ' /proc/mounts && return 0
    mkdir -p /boot
    mount -t vfat -o rw /dev/vda1 /boot 2>/dev/null
}

env_get() {
    sed -n "s/^$1=//p" "$ENV_FILE" 2>/dev/null | head -1
}

env_write() {
    s=$1
    t=$2
    g=$3
    q=$4
    b=$5
    l=$6
    order=$7
    # Preserve keys we do not own (e.g. RAUC A_OK, B_OK). ORDER is
    # owned by us: caller passes it as $7, or we keep the old value.
    # grub.cfg reads ORDER first, falls back to slot only if ORDER
    # absent. Without ORDER sync here, demote/trial would leave ORDER
    # pointing at the other slot — grub.cfg ignores the slot change
    # and boots the same (failing) slot — boot loop.
    old_order=$(env_get ORDER)
    extra=""
    if [ -f "$ENV_FILE" ]; then
        extra=$(sed 's/#.*//' "$ENV_FILE" 2>/dev/null | grep '=' | \
            grep -vE '^(slot|tries|good|seq|booted|lkg|ORDER)=' || true)
    fi
    {
        printf '# GRUB Environment Block\n'
        printf 'slot=%s\n' "$s"
        printf 'tries=%s\n' "$t"
        printf 'good=%s\n' "$g"
        printf 'seq=%s\n' "$q"
        printf 'booted=%s\n' "$b"
        printf 'lkg=%s\n' "$l"
        if [ -n "$order" ]; then
            printf 'ORDER=%s\n' "$order"
        elif [ -n "$old_order" ]; then
            printf 'ORDER=%s\n' "$old_order"
        fi
        if [ -n "$extra" ]; then
            printf '%s\n' "$extra"
        fi
    } > "$ENV_TMP"
    n=$((1024 - $(wc -c < "$ENV_TMP")))
    if [ "$n" -gt 0 ]; then
        dd if=/dev/zero bs=1 count="$n" 2>/dev/null | tr '\000' '#' >> "$ENV_TMP"
    fi
    # Atomic rename: old grubenv stays intact until rename succeeds. If
    # power loss hits mid-write, the tmp file is lost and the old block
    # is untouched. vfat on Linux treats rename as an atomic directory
    # operation within one fs.
    mv "$ENV_TMP" "$ENV_FILE" || {
        rm -f "$ENV_TMP"
        return 1
    }
    sync
}

slot_now() {
    sed -n 's/.*slot=\([AB]\).*/\1/p' /proc/cmdline | head -1
}

other_of() {
    if [ "$1" = A ]; then echo B; else echo A; fi
}

seq_next() {
    q=$(env_get seq)
    case "$q" in
        ''|*[!0-9]*) q=0 ;;
    esac
    echo $((q + 1))
}

ensure_mount
[ -f "$ENV_FILE" ] || exit 1

case "$1" in
    get)
        env_get "$2"
        ;;
    show)
        for k in slot tries good seq booted lkg ORDER; do
            printf '%s=%s\n' "$k" "$(env_get "$k")"
        done
        ;;
    commit)
        s=$(slot_now)
        [ -n "$s" ] || exit 1
        o=$(other_of "$s")
        env_write "$s" 0 1 "$(seq_next)" "$s" "$s" "$s $o"
        ;;
    trial)
        n=$2
        [ "$n" = A ] || [ "$n" = B ] || exit 1
        c=$(slot_now)
        [ -n "$c" ] || c=A
        o=$(other_of "$n")
        env_write "$n" 3 0 "$(seq_next)" "$n" "$c" "$n $o"
        ;;
    demote)
        # Roll back from the current (failing) slot. The broken slot is
        # already flagged bad by `rauc status mark-bad` (B_OK=0 lives in
        # grubenv from that call). This entry only needs to point GRUB at
        # the healthy other slot with a clean trial counter. Prior code
        # used tries=3, good=0, lkg=$c, which left the healthy slot
        # looking untrustworthy and the broken slot labelled last-known-good.
        c=$(slot_now)
        [ -n "$c" ] || c=A
        o=$(other_of "$c")
        env_write "$o" 0 1 "$(seq_next)" "$o" "$o" "$o $c"
        ;;
    *)
        echo "usage: wraith-bootenv get|show|commit|trial|demote"
        exit 1
        ;;
esac
