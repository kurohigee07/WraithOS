#!/bin/sh
# Wrapper around `rauc install` that arms the health-gated rollback.
# Usage: wraith-install-bundle /path/to/bundle.raucb
#
# Writes /data/orchestrator/rauc.pending on success. On the next boot
# S99wraith-init spawns wraith-rauc-healthcheck, which polls /readyz
# for 60 s. If the orchestrator is healthy it runs rauc status
# mark-good + wraith-bootenv commit; if not it marks bad, demotes the
# bootenv, and reboots into the last-known-good slot.
set -u

# v0.53 dm-verity guard: the root hash + salt live in grub.cfg on the
# ESP, baked at build time. Neither this script nor RAUC updates that
# block, so writing a different squashfs to the inactive slot would
# mismatch the baked hash, panic at boot, and roll back. Refuse unless
# dm-verity is off the cmdline. v0.54 adds a post-install hook that
# recomputes the hash and rewrites grub.cfg; until then, update by
# flashing a full image over USB.
if grep -q 'dm-mod.create=' /proc/cmdline 2>/dev/null; then
    echo "ERROR: dm-verity is active on this image." >&2
    echo "In-place updates are not supported on v0.53+." >&2
    echo "Flash a full image over USB instead. See docs/wraithos.md." >&2
    exit 1
fi

if [ "$#" -ne 1 ]; then
    echo "usage: $0 /path/to/bundle.raucb" >&2
    exit 1
fi

BUNDLE=$1
if [ ! -f "$BUNDLE" ]; then
    echo "not found: $BUNDLE" >&2
    exit 1
fi

if [ ! -d /data ]; then
    echo "/data not mounted; cannot record pending marker" >&2
    exit 1
fi

echo "── rauc install $BUNDLE"
if ! rauc install "$BUNDLE"; then
    echo "rauc install failed; not arming health check" >&2
    exit 1
fi

mkdir -p /data/orchestrator
printf 'armed %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > /data/orchestrator/rauc.pending
sync

echo ""
echo "Bundle staged. Reboot to activate."
echo "On next boot, /readyz is polled for 60 s. Success commits the slot;"
echo "failure marks it bad and rolls back to the previous slot automatically."
