# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Runtime artifacts
*.db
*.db-wal
*.db-shm
modules/**/*.wasm
!modules/.gitkeep

# Backup / temp files from editing
*.bak
*.orig
*.pre-*

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
logs/
core.*
modules/**/*.wasm.quota.json
modules/**/*.wasm.sig
orchestrator.toml.bak
modules/**/*.wasm.capabilities.json
dist/
data/
tests/fixtures/*/target/
tests/fixtures/*/Cargo.lock

# Termux package
deploy/wraithos/termux-package/orchestrator
deploy/wraithos/termux-package/*.db*
deploy/wraithos/termux-package/logs/

# RAUC CA private material — must never be committed
deploy/wraithos/rauc-ca/*.key
deploy/wraithos/rauc-ca/*.csr
deploy/wraithos/rauc-ca/*.srl
deploy/wraithos/rauc-ca/dev.cert.pem
