# WraithOS shell profile
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
export TERM=${TERM:-linux}
export PS1='\[\e[1;35m\]wraith\[\e[0m\]@\[\e[1;36m\]\h\[\e[0m\]:\[\e[1;33m\]\w\[\e[0m\]\$ '

# Colored ls
alias ls='ls --color=auto'
alias ll='ls -lah'
alias grep='grep --color=auto'

# WraithOS banner di setiap login shell
if [ -n "$PS1" ] && [ -z "$WRAITHOS_SHOWN" ]; then
    echo ""
    echo "  Type 'wraith-help' for quick commands"
    echo ""
    export WRAITHOS_SHOWN=1
fi
