#!/bin/sh
# Wraith Boot Contract: 1024-byte GRUB env block on ESP.
ENV_FILE=/boot/grub/grubenv
ENV_TMP=/run/wraith/grubenv.tmp
mkdir -p /run/wraith

ensure_mount() {
    grep -q ' /boot ' /proc/mounts && return 0
    mkdir -p /boot
    mount -t vfat -o rw /dev/vda1 /boot 2>/dev/null
}

env_get() {
    sed -n "s/^$1=//p" "$ENV_FILE" 2>/dev/null | head -1
}

env_write() {
    s=$1
    t=$2
    g=$3
    q=$4
    b=$5
    l=$6
    {
        printf '# GRUB Environment Block\n'
        printf 'slot=%s\n' "$s"
        printf 'tries=%s\n' "$t"
        printf 'good=%s\n' "$g"
        printf 'seq=%s\n' "$q"
        printf 'booted=%s\n' "$b"
        printf 'lkg=%s\n' "$l"
    } > "$ENV_TMP"
    n=$((1024 - $(wc -c < "$ENV_TMP")))
    if [ "$n" -gt 0 ]; then
        dd if=/dev/zero bs=1 count="$n" 2>/dev/null | tr '\000' '#' >> "$ENV_TMP"
    fi
    cat "$ENV_TMP" > "$ENV_FILE"
    rm -f "$ENV_TMP"
    sync
}

slot_now() {
    sed -n 's/.*slot=\([AB]\).*/\1/p' /proc/cmdline | head -1
}

other_of() {
    if [ "$1" = A ]; then echo B; else echo A; fi
}

seq_next() {
    q=$(env_get seq)
    case "$q" in
        ''|*[!0-9]*) q=0 ;;
    esac
    echo $((q + 1))
}

ensure_mount
[ -f "$ENV_FILE" ] || exit 1

case "$1" in
    get)
        env_get "$2"
        ;;
    show)
        for k in slot tries good seq booted lkg; do
            printf '%s=%s\n' "$k" "$(env_get "$k")"
        done
        ;;
    commit)
        s=$(slot_now)
        [ -n "$s" ] || exit 1
        env_write "$s" 0 1 "$(seq_next)" "$s" "$s"
        ;;
    trial)
        n=$2
        [ "$n" = A ] || [ "$n" = B ] || exit 1
        c=$(slot_now)
        [ -n "$c" ] || c=A
        env_write "$n" 3 0 "$(seq_next)" "$n" "$c"
        ;;
    demote)
        c=$(slot_now)
        [ -n "$c" ] || c=A
        o=$(other_of "$c")
        env_write "$o" 3 0 "$(seq_next)" "$o" "$c"
        ;;
    *)
        echo "usage: wraith-bootenv get|show|commit|trial|demote"
        exit 1
        ;;
esac
