# Arsitektur
BR2_x86_64=y
BR2_x86_64_generic=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=n

# Init System
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_GETTY_PORT="tty1"

# Kernel (custom, di-tuning)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="/home/opc/wraithos-br2-ext/board/wraithos/kernel.fragment"

# Filesystem SquashFS + Overlay (Level 2 spec)
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_COMP_LZ4=y
BR2_TARGET_ROOTFS_TAR=n

# Systemd + network
BR2_SYSTEM_DHCP="eth0"

# Runtime libs yang dibutuhin orchestrator
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Utils buat debug
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_HTOP=y

# Overlay custom kita (systemd units, orchestrator binary)
BR2_ROOTFS_OVERLAY="/home/opc/wraithos-br2-ext/board/wraithos/rootfs_overlay"
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_SKIP_LEGACY=y
